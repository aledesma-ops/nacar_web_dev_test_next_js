# --- CMS --------------------------------------------------------------------
# Repositorio donde vive el contenido, en formato "owner/repo".
# Si esta variable está vacía, /keystatic escribe en el sistema de ficheros
# local (modo desarrollo). Al definirla, el panel pasa a modo GitHub.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# Credenciales de la GitHub App que da acceso al panel.
# Se generan una sola vez desde /keystatic/setup con el proyecto ya desplegado.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# --- Sitio ------------------------------------------------------------------
# Dominio definitivo. De él dependen canonical, hreflang, sitemap e imágenes OG.
# En Vercel se puede omitir: se deduce del dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=
